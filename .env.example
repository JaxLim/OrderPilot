# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.
#   docker compose reads it automatically; `mvn spring-boot:run` imports it via spring.config.import.

# --- AI copilot (DeepSeek, or any OpenAI-compatible API) ---
# Leave AI_API_KEY empty to run the copilot in offline-analyst mode.
AI_API_KEY=sk-your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_PROVIDER_NAME=DeepSeek

# --- Security ---
# Optional locally: when empty the backend signs with a random key and sessions end at restart.
# Required with the prod profile, which refuses to start without a strong value. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
